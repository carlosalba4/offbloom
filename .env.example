# ---- LLM provider (the app is provider-agnostic) ----
# ollama = local / privacy mode  |  openai/google/anthropic = cloud (public demo)
LLM_PROVIDER=ollama

# Local (Ollama) settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Cloud API settings (used when LLM_PROVIDER != ollama)
API_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings (multilingual, runs locally via Ollama)
EMBEDDING_MODEL=bge-m3

# Vector store
CHROMA_DIR=./.chroma

# Langfuse (observability) — optional, leave blank to disable
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
