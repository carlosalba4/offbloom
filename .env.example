# ---- LLM provider (the app is provider-agnostic) ----
# ollama = local / privacy mode  |  openai/google/anthropic = cloud (public demo)
LLM_PROVIDER=ollama

# Local (Ollama) settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Cloud API settings (used when LLM_PROVIDER != ollama)
API_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings (multilingual, runs locally via Ollama)
EMBEDDING_MODEL=bge-m3

# Vector store
CHROMA_DIR=./.chroma

# Autenticación JWT — OBLIGATORIO. Debe tener al menos 32 bytes. Genera un
# secreto aleatorio propio, p.ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Nunca reutilices el mismo secreto entre entornos (dev/CI/producción).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Langfuse (agent tracing) — OPTIONAL. Leave blank to run without tracing:
# the coach works fine, just without observability. To enable, create a
# project at LANGFUSE_HOST and paste both keys below.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
